NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Private admin login alias. Keep the matching Supabase Auth account as an admin profile.
SVASTIDA_ADMIN_ID=Svastida@2026
SVASTIDA_ADMIN_EMAIL=

# Free click-to-chat fallback. Can also be managed from admin settings.
WHATSAPP_ADMIN_NUMBER=

# Optional true WhatsApp Cloud API delivery.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Server-only AI provider key.
AI_PROVIDER_API_KEY=
AI_IMAGE_MODEL=gpt-image-2.5-flare
AI_PROVIDER_BASE_URL=
