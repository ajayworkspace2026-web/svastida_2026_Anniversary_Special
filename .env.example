NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Admin WhatsApp number can also be managed in site_settings.
WHATSAPP_ADMIN_NUMBER=

# Server-only AI provider key.
AI_PROVIDER_API_KEY=
AI_IMAGE_MODEL=gpt-image-2.5-flare

# Optional provider override for a future compatible gateway.
AI_PROVIDER_BASE_URL=
